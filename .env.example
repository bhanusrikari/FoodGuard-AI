# FoodGuard AI — backend environment variables.
#
# Copy relevant values into your actual environment (a real .env file, your
# shell, or your hosting provider's dashboard). NEVER commit a real .env
# file — it is already in .gitignore.
#
# Everything here has a safe default for local development (see
# config/settings.py) except DJANGO_SECRET_KEY, which is REQUIRED once
# DJANGO_DEBUG=False.

# --- Core Django ------------------------------------------------------
# Required in production (DJANGO_DEBUG=False). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Defaults to True (local dev). MUST be False in any real deployment.
DJANGO_DEBUG=True
# Comma-separated. Default: 127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated. Only enforced when DJANGO_DEBUG=False.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Default True when DJANGO_DEBUG=False.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
FOODGUARD_LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# Hosted deployments (Render, etc.): set DATABASE_URL and it overrides
# everything below. Render injects this automatically when a Postgres
# instance is linked to the web service.
DATABASE_URL=
# Local development only (used when DATABASE_URL is unset):
DATABASE_NAME=foodguard_db
DATABASE_USER=foodguard_user
DATABASE_PASSWORD=foodguard_password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434

# --- CORS -----------------------------------------------------------------
# Comma-separated frontend origin(s). Default: the local Vite dev origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI analysis / ML model ------------------------------------------------
# Directory containing model.pt / label_map.json / train_config.json.
# Default: <project_root>/models/food_quality/
FOOD_QUALITY_MODEL_DIR=
# Below this confidence, results are forced to HUMAN_REVIEW. Default 0.70.
AI_CONFIDENCE_THRESHOLD=0.70

# --- Translation ------------------------------------------------------------
# "none" (default) returns an explicit "unavailable" result rather than
# fabricating a translation. Set to a real provider name once one exists.
TRANSLATION_PROVIDER=none

# --- Media --------------------------------------------------------------
# Default True: Django itself serves /media/ (fine for this MVP's scale).
# Set False once a reverse proxy / object storage serves it directly.
SERVE_MEDIA_VIA_DJANGO=True
